<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gmail - Inbox (mahak123@gmail.com)</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <style>
    /* Base Reset */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Roboto', sans-serif;
    }

    body {
      background-color: #ffffff;
      color: #202124;
      overflow: hidden;
      height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Live Server Status Bar */
    .server-status-bar {
      background-color: #fce8e6;
      color: #c5221f;
      padding: 8px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 14px;
      font-weight: 500;
      border-bottom: 1px solid #fad2cf;
    }

    .timer-badge {
      background-color: #c5221f;
      color: white;
      padding: 2px 8px;
      border-radius: 4px;
      font-weight: bold;
    }

    /* Navbar styles */
    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 20px;
      background: #f6f8fc;
      border-bottom: 1px solid #eaf1fb;
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 22px;
      font-weight: 400;
      color: #1f1f1f;
    }

    .logo img {
      height: 24px;
    }

    .search-container {
      flex: 1;
      max-width: 720px;
      margin: 0 40px;
      display: flex;
      align-items: center;
      background: #eaf1fb;
      padding: 10px 16px;
      border-radius: 24px;
      gap: 12px;
    }

    .search-container input {
      border: none;
      background: transparent;
      width: 100%;
      outline: none;
      font-size: 16px;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #eaf1fb;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 14px;
    }

    .avatar {
      width: 32px;
      height: 32px;
      background: #b3261e;
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
    }

    /* Main Layout */
    .main-container {
      display: flex;
      flex: 1;
      overflow: hidden;
    }

    /* Sidebar */
    .sidebar {
      width: 256px;
      background: #f6f8fc;
      padding: 12px;
      display: flex;
      flex-direction: column;
    }

    .btn-compose {
      display: flex;
      align-items: center;
      gap: 12px;
      background: #c2e7ff;
      border: none;
      padding: 16px 24px;
      border-radius: 16px;
      font-size: 14px;
      font-weight: 500;
      color: #001d35;
      margin-bottom: 16px;
      cursor: pointer;
      width: fit-content;
      box-shadow: 0 1px 3px 0 rgba(60,64,67,0.3);
    }

    .sidebar-menu {
      list-style: none;
    }

    .sidebar-menu li {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 12px;
      height: 32px;
      border-radius: 16px;
      font-size: 14px;
      color: #1f1f1f;
      cursor: pointer;
      margin-bottom: 4px;
    }

    .sidebar-menu li.active {
      background: #d3e3fd;
      color: #041e49;
      font-weight: 700;
    }

    /* Email Content Area */
    .email-area {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: #ffffff;
      margin: 8px 16px 16px 0;
      border-radius: 16px;
      border: 1px solid #e0e0e0;
      overflow: hidden;
    }

    .email-tabs {
      display: flex;
      border-bottom: 1px solid #f1f3f4;
      background: #ffffff;
    }

    .tab {
      width: 250px;
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 15px 20px;
      font-size: 14px;
      font-weight: 500;
      color: #444746;
      cursor: pointer;
      border-bottom: 3px solid transparent;
    }

    .tab.active {
      color: #0b57d0;
      border-bottom-color: #0b57d0;
    }

    .email-list {
      flex: 1;
      overflow-y: auto;
    }

    .email-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 16px;
      border-bottom: 1px solid #f1f3f4;
      font-size: 14px;
      cursor: pointer;
    }

    .email-row:hover {
      box-shadow: inset 1px 0 0 #dadce0, inset -1px 0 0 #dadce0, 0 1px 2px 0 rgba(60,64,67,.3), 0 1px 3px 1px rgba(60,64,67,.15);
      z-index: 1;
    }

    .email-row.unread {
      background: #f2f6fc;
      font-weight: 700;
    }

    .row-left {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 200px;
    }

    .sender {
      color: #1f1f1f;
    }

    .subject-container {
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      padding: 0 16px;
    }

    .snippet {
      font-weight: 400;
      color: #5f6368;
    }

    .time {
      font-size: 12px;
      color: #5f6368;
      font-weight: 500;
    }

    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 20;
      vertical-align: middle;
      color: #444746;
    }
    
    .star { color: #c4c7c5; }
  </style>
</head>
<body>

  <div class="server-status-bar">
    <span>⚠️ Live Server Testing Mode Active</span>
    <span>Session Ends In: <span class="timer-badge" id="countdown">10s</span></span>
  </div>

  <header class="navbar">
    <div class="nav-left">
      <span class="material-symbols-outlined" style="cursor: pointer;">menu</span>
      <div class="logo">
        <img src="https://upload.wikimedia.org/wikipedia/commons/7/7e/Gmail_icon_%282020%29.svg" alt="Gmail Logo">
        <span>Gmail</span>
      </div>
    </div>
    
    <div class="search-container">
      <span class="material-symbols-outlined">search</span>
      <input type="text" placeholder="Search mail">
    </div>

    <div class="nav-right">
      <span class="material-symbols-outlined">help</span>
      <span class="material-symbols-outlined">settings</span>
      <span class="material-symbols-outlined">apps</span>
      <div class="user-profile">
        <span>mahak123@gmail.com</span>
        <div class="avatar">M</div>
      </div>
    </div>
  </header>

  <div class="main-container">
    
    <aside class="sidebar">
      <button class="btn-compose">
        <span class="material-symbols-outlined">edit</span> Compose
      </button>
      <ul class="sidebar-menu">
        <li class="active"><span class="material-symbols-outlined">inbox</span> Inbox</li>
        <li><span class="material-symbols-outlined">star</span> Starred</li>
        <li><span class="material-symbols-outlined">schedule</span> Snoozed</li>
        <li><span class="material-symbols-outlined">send</span> Sent</li>
        <li><span class="material-symbols-outlined">description</span> Drafts</li>
      </ul>
    </aside>

    <main class="email-area">
      <div class="email-tabs">
        <div class="tab active"><span class="material-symbols-outlined">inbox</span> Primary</div>
        <div class="tab"><span class="material-symbols-outlined">group</span> Social</div>
        <div class="tab"><span class="material-symbols-outlined">local_offer</span> Promotions</div>
      </div>
      
      <div class="email-list">
        
        <div class="email-row unread">
          <div class="row-left">
            <input type="checkbox">
            <span class="material-symbols-outlined star">star</span>
            <span class="sender">Google Security</span>
          </div>
          <div class="subject-container">
            <span>New Sign-in detected <span class="snippet">- We noticed a new login to your mahak123@gmail.com account...</span></span>
          </div>
          <span class="time">10:45 AM</span>
        </div>

        <div class="email-row unread">
          <div class="row-left">
            <input type="checkbox">
            <span class="material-symbols-outlined star">star</span>
            <span class="sender">GitHub Team</span>
          </div>
          <div class="subject-container">
            <span>[GitHub] Please verify your device <span class="snippet">- A verification code has been sent to authorize your account...</span></span>
          </div>
          <span class="time">09:12 AM</span>
        </div>

        <div class="email-row unread">
          <div class="row-left">
            <input type="checkbox">
            <span class="material-symbols-outlined star">star</span>
            <span class="sender">Medium Daily</span>
          </div>
          <div class="subject-container">
            <span>Stories for Mahak <span class="snippet">- Top 5 articles on Web Development and Javascript performance tricks inside...</span></span>
          </div>
          <span class="time">07:30 AM</span>
        </div>

        <div class="email-row">
          <div class="row-left">
            <input type="checkbox">
            <span class="material-symbols-outlined star">star</span>
            <span class="sender">LinkedIn Jobs</span>
          </div>
          <div class="subject-container">
            <span>30+ New jobs matching your profile <span class="snippet">- Hi Mahak, check out these recent node.js developer roles...</span></span>
          </div>
          <span class="time">Yesterday</span>
        </div>

        <div class="email-row">
          <div class="row-left">
            <input type="checkbox">
            <span class="material-symbols-outlined star">star</span>
            <span class="sender">Vercel</span>
          </div>
          <div class="subject-container">
            <span>Deployment Successful <span class="snippet">- Your project 'gmail-clone' has been successfully deployed to production...</span></span>
          </div>
          <span class="time">Jul 7</span>
        </div>

        <div class="email-row">
          <div class="row-left">
            <input type="checkbox">
            <span class="material-symbols-outlined star">star</span>
            <span class="sender">Codecademy</span>
          </div>
          <div class="subject-container">
            <span>Keep your weekly streak alive! <span class="snippet">- Finish your next CSS grid lesson today to stay on track...</span></span>
          </div>
          <span class="time">Jul 6</span>
        </div>

        <div class="email-row">
          <div class="row-left">
            <input type="checkbox">
            <span class="material-symbols-outlined star">star</span>
            <span class="sender">Stack Overflow</span>
          </div>
          <div class="subject-container">
            <span>The Overflow #341 <span class="snippet">- AI in coding tools, top community answers this week, and new features...</span></span>
          </div>
          <span class="time">Jul 5</span>
        </div>

        <div class="email-row">
          <div class="row-left">
            <input type="checkbox">
            <span class="material-symbols-outlined star">star</span>
            <span class="sender">Spotify India</span>
          </div>
          <div class="subject-container">
            <span>Your Release Radar is ready <span class="snippet">- Catch up with the newest music releases from your favorite artists...</span></span>
          </div>
          <span class="time">Jul 3</span>
        </div>

        <div class="email-row">
          <div class="row-left">
            <input type="checkbox">
            <span class="material-symbols-outlined star">star</span>
            <span class="sender">Figma</span>
          </div>
          <div class="subject-container">
            <span>Updates to your shared project <span class="snippet">- New comments added to 'Gmail UI Mockup v2' by the design team...</span></span>
          </div>
          <span class="time">Jun 30</span>
        </div>

      </div>
    </main>
  </div>

  <script>
    let timeLeft = 10;
    const countdownElement = document.getElementById('countdown');

    const timer = setInterval(() => {
      timeLeft--;
      countdownElement.textContent = timeLeft + 's';

      if (timeLeft <= 0) {
        clearInterval(timer);
        window.location.href = '/logout';
      }
    }, 1000);
  </script>

</body>
</html>