<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registered Users List</title>
    <!-- Bootstrap Styling -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Google Sans', Roboto, system-ui, -apple-system, sans-serif;
        }

        body { 
            width: 100vw;
            min-height: 100vh;
            display: flex; 
            justify-content: center; 
            align-items: center; 
            background: radial-gradient(circle at 50% 50%, #fdfcfc 0%, #f5f2f2 100%); 
            position: relative;
            overflow-x: hidden; 
            perspective: 2000px;
            margin: 0;
            padding: 40px 0;
        }

        /* --- RED AND WHITE THEME AMBIENT GLOW --- */
        body::before {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(234, 67, 53, 0.08) 0%, transparent 70%);
            top: -10%;
            right: -5%;
            filter: blur(60px);
            z-index: 1;
        }

        /* --- FIXED FLOATING LETTERS & EMOJIS (DATA LIST THEME) --- */
        .bg-element {
            position: fixed; 
            color: rgba(234, 67, 53, 0.12); 
            font-weight: 800;
            pointer-events: none;
            user-select: none;
            animation: floatUpDown 14s linear infinite;
            z-index: 1;
            filter: drop-shadow(0 2px 5px rgba(234, 67, 53, 0.08));
        }

        /* Positions and Sizes for D-A-T-A */
        .p1 { top: 10%; left: 6%; animation-delay: 0s; font-size: 75px; }
        .p2 { top: 22%; right: 8%; animation-delay: 3s; font-size: 70px; }
        .p3 { bottom: 15%; left: 10%; animation-delay: 6s; font-size: 85px; }
        .p4 { bottom: 25%; right: 6%; animation-delay: 1.5s; font-size: 75px; }
        
        /* List & Database Emojis */
        .e1 { top: 5%; right: 45%; animation-delay: 2s; font-size: 50px; opacity: 0.3; }  
        .e2 { bottom: 8%; left: 45%; animation-delay: 5s; font-size: 55px; opacity: 0.3; } 
        .e3 { top: 60%; left: 20%; animation-delay: 9s; font-size: 45px; opacity: 0.3; } 
        .e4 { top: 35%; right: 22%; animation-delay: 1s; font-size: 48px; opacity: 0.3; } 

        @keyframes floatUpDown {
            0% {
                transform: translateY(105vh) rotate(0deg) scale(0.9);
                opacity: 0;
            }
            15% { opacity: 1; }
            85% { opacity: 1; }
            100% {
                transform: translateY(-15vh) rotate(360deg) scale(1.3);
                opacity: 0;
            }
        }

        /* --- CONTAINER MIXED WITH PREMIUM CARD --- */
        .list-card {
            background: #ffffff; 
            padding: 40px; 
            border-radius: 32px; 
            border: 2px solid #fce8e6;
            z-index: 2;
            box-shadow: 0 10px 35px rgba(234, 67, 53, 0.04);
            backdrop-filter: blur(10px);
            transform-style: preserve-3d;
            transition: all 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
            width: 100%;
        }

        .list-card:hover {
            transform: translateY(-5px) rotateX(2deg) rotateY(2deg); 
            border-color: rgba(234, 67, 53, 0.4); 
            box-shadow: 
                0 0 35px rgba(234, 67, 53, 0.2),   
                0 20px 45px rgba(234, 67, 53, 0.08);
        }

        .list-title {
            font-size: 30px;
            font-weight: 500;
            color: #ea4335; /* Premium Gmail Red Header */
            letter-spacing: -0.5px;
            transform: translateZ(25px);
        }

        /* --- PREMIUM RED TABLE STYLING --- */
        .table-responsive {
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid #fce8e6;
            transform: translateZ(15px);
        }

        .table {
            margin-bottom: 0;
            vertical-align: middle;
        }

        .table thead {
            background-color: #ea4335 !important; /* Pure Red Header */
            color: white !important;
        }

        .table th {
            padding: 15px 20px !important;
            font-weight: 500;
            border: none !important;
            background-color: #ea4335 !important;
            color: white !important;
        }

        .table td {
            padding: 14px 20px !important;
            color: #3c4043;
            font-size: 15px;
            border-bottom: 1px solid #f1f3f4;
        }

        /* Custom Hover row colour */
        .table-hover tbody tr:hover {
            background-color: #fff5f4 !important; 
        }

        /* --- NAVIGATION BUTTON (PREMIUM RED) --- */
        .btn-register-redirect {
            background-color: #ea4335;
            color: white;
            font-weight: 500;
            padding: 13px 30px;
            border-radius: 100px;
            border: none;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-block;
            transform: translateZ(20px);
        }

        .btn-register-redirect:hover {
            background-color: #d93025;
            color: white;
            box-shadow: 0 4px 18px rgba(234, 67, 53, 0.45);
            transform: translateY(-2px);
        }
    </style>
</head>
<body>

<!-- Background Floating Elements (D-A-T-A) -->
<div class="bg-element p1">D</div>
<div class="bg-element p2">A</div>
<div class="bg-element p3">T</div>
<div class="bg-element p4">A</div>

<!-- Table / Dashboard Themed Emojis -->
<div class="bg-element e1">📋</div> 
<div class="bg-element e2">📊</div> 
<div class="bg-element e3">👥</div> 
<div class="bg-element e4">💻</div> 

<div class="container">
    <div class="row justify-content-center">
        <!-- Dashboard Card Layout width set to 10 columns for cleaner spacing -->
        <div class="col-md-10">
            
            <div class="list-card">
                <h3 class="text-center mb-4 list-title">Registered Users List</h3>
                
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Full Name</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Password</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each list}}
                            <tr>
                                <td>{{this.fullName}}</td>
                                <td>{{this.username}}</td>
                                <td>{{this.email}}</td>
                                <td>{{this.password}}</td>
                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No users found in the database.</td>
                            </tr>
                            {{/each}}
                        </tbody>
                    </table>
                </div>

                <div class="text-center mt-4">
                    <a href="/register" class="btn-register-redirect">Go to Register Page</a>
                </div>
            </div>

        </div>
    </div>
</div>

</body>
</html>