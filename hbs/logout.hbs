<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Logged Out</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Google Sans', Roboto, system-ui, -apple-system, sans-serif;
        }

        body {
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: radial-gradient(circle at 50% 50%, #fdfcfc 0%, #f5f2f2 100%);
            position: relative;
            overflow: hidden; 
            perspective: 2000px;
        }

        /* --- RED AND WHITE THEME AMBIENT GLOW IN BACKGROUND --- */
        body::before {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(234, 67, 53, 0.08) 0%, transparent 70%);
            top: -10%;
            right: -5%;
            filter: blur(60px);
            z-index: 1;
        }

        /* --- FIXED FLOATING LETTERS & EMOJIS --- */
        .bg-element {
            position: fixed; 
            color: rgba(234, 67, 53, 0.15); 
            font-weight: 800;
            pointer-events: none;
            user-select: none;
            animation: floatUpDown 14s linear infinite;
            z-index: 1;
            filter: drop-shadow(0 2px 5px rgba(234, 67, 53, 0.1));
        }

        /* Positions and Sizes */
        .p1 { top: 12%; left: 8%; animation-delay: 0s; font-size: 70px; }
        .p2 { top: 22%; right: 12%; animation-delay: 3s; font-size: 65px; }
        .p3 { bottom: 18%; left: 15%; animation-delay: 6s; font-size: 80px; }
        .p4 { bottom: 22%; right: 8%; animation-delay: 1.5s; font-size: 75px; }
        .p5 { top: 45%; left: 4%; animation-delay: 8s; font-size: 55px; }
        .p6 { bottom: 45%; right: 4%; animation-delay: 4.5s; font-size: 72px; }
        
        .e1 { top: 5%; right: 40%; animation-delay: 2s; font-size: 50px; opacity: 0.3; }
        .e2 { bottom: 8%; left: 45%; animation-delay: 5s; font-size: 55px; opacity: 0.3; }
        .e3 { top: 60%; left: 22%; animation-delay: 9s; font-size: 45px; opacity: 0.3; }
        .e4 { top: 35%; right: 25%; animation-delay: 1s; font-size: 48px; opacity: 0.3; }

        @keyframes floatUpDown {
            0% {
                transform: translateY(105vh) rotate(0deg) scale(0.9);
                opacity: 0;
            }
            15% { opacity: 1; }
            85% { opacity: 1; }
            100% {
                transform: translateY(-15vh) rotate(360deg) scale(1.3);
                opacity: 0;
            }
        }

        /* --- LOGOUT MAIN CARD (PERFECTLY CENTERED FIX) --- */
        .logout-box {
            width: 420px;
            background: #ffffff; 
            padding: 45px 35px;
            border-radius: 32px;
            border: 2px solid #fce8e6; 
            text-align: center;
            z-index: 2;
            box-shadow: 0 10px 35px rgba(234, 67, 53, 0.04);
            backdrop-filter: blur(10px);
            transform-style: preserve-3d;
            transition: all 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
            /* Yeh ensure karega ki box flex elements ke dabav me na aaye aur exact center me rahe */
            margin: auto; 
        }

        /* --- RED GLOW LIGHT EFFECT ON HOVER --- */
        .logout-box:hover {
            transform: translateY(-6px) rotateX(4deg) rotateY(5deg); 
            border-color: rgba(234, 67, 53, 0.5); 
            box-shadow: 
                0 0 35px rgba(234, 67, 53, 0.25),   
                0 20px 45px rgba(234, 67, 53, 0.1),    
                0 4px 12px rgba(0, 0, 0, 0.02);
        }

        /* --- CARD INNER ELEMENTS --- */
        .icon-container {
            margin-bottom: 24px;
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 80px;
            height: 80px;
            background: #fce8e6; 
            border-radius: 24px;
            position: relative;
            transform: translateZ(30px);
            transition: transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        .logout-box:hover .icon-container {
            background: #fad2cf;
            transform: translateZ(45px) scale(1.08);
        }

        .logout-box h2 {
            font-size: 26px;
            font-weight: 500;
            color: #1f1f1f;
            margin-bottom: 12px;
            letter-spacing: -0.5px;
            transform: translateZ(20px);
        }

        .logout-box p {
            font-size: 15px;
            color: #5f6368;
            line-height: 1.6;
            margin-bottom: 35px;
            padding: 0 10px;
            transform: translateZ(15px);
        }

        .btn-container {
            display: flex;
            flex-direction: column;
            gap: 14px;
            transform: translateZ(25px);
        }

        /* Premium Gmail Red Button */
        .btn-primary {
            width: 100%;
            padding: 14px;
            background: #ea4335; 
            color: white;
            border: none;
            border-radius: 100px;
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary:hover {
            background: #d93025; 
            box-shadow: 0 4px 18px rgba(234, 67, 53, 0.45);
            transform: translateY(-2px);
        }

        /* Premium Red Outline Button */
        .btn-secondary {
            width: 100%;
            padding: 14px;
            background: transparent;
            color: #ea4335; 
            border: 1px solid #f5b7b1;
            border-radius: 100px;
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-secondary:hover {
            background: #fdf5f4;
            border-color: #ea4335;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>

    <!-- Background Elements -->
    <div class="bg-element p1">L</div>
    <div class="bg-element p2">O</div>
    <div class="bg-element p3">G</div>
    <div class="bg-element p4">O</div>
    <div class="bg-element p5">U</div>
    <div class="bg-element p6">T</div>

    <div class="bg-element e1">✉️</div> 
    <div class="bg-element e2">🚪</div> 
    <div class="bg-element e3">🔒</div> 
    <div class="bg-element e4">RUN</div> 

    <!-- Perfectly Centered Logout Container -->
    <div class="logout-box">

        <div class="icon-container">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1ZM12 7C13.66 7 15 8.34 15 10V12H16C16.55 12 17 12.45 17 13V18C17 18.55 16.55 19 16 19H8C7.45 19 7 18.55 7 18V13C7 12.45 7.45 12 8 12H9V10C9 8.34 10.34 7 12 7ZM10.5 10V12H13.5V10C13.5 9.17 12.83 8.5 12 8.5C11.17 8.5 10.5 9.17 10.5 10Z" fill="#ea4335"/>
            </svg>
        </div>

        <h2>Logged Out</h2>
        
        <p>Your session has expired or you have logged out successfully.</p>

        <div class="btn-container">
            <a href="/login" class="btn-primary">Login Again</a>
            <a href="/" class="btn-secondary">Go to Home Page</a>
        </div>

    </div>

</body>
</html>