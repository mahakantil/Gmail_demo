<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Google Sans', Roboto, system-ui, -apple-system, sans-serif;
        }

        body {
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: radial-gradient(circle at 50% 50%, #fdfcfc 0%, #f5f2f2 100%);
            position: relative;
            overflow: hidden; 
            perspective: 2000px;
        }

        /* --- RED AND WHITE THEME AMBIENT GLOW --- */
        body::before {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(234, 67, 53, 0.08) 0%, transparent 70%);
            top: -10%;
            right: -5%;
            filter: blur(60px);
            z-index: 1;
        }

        /* --- FIXED FLOATING LETTERS & EMOJIS (REGISTER THEME) --- */
        .bg-element {
            position: fixed; 
            color: rgba(234, 67, 53, 0.15); 
            font-weight: 800;
            pointer-events: none;
            user-select: none;
            animation: floatUpDown 14s linear infinite;
            z-index: 1;
            filter: drop-shadow(0 2px 5px rgba(234, 67, 53, 0.1));
        }

        /* Positions and Sizes for R-E-G-I-S-T-E-R */
        .p1 { top: 8%; left: 8%; animation-delay: 0s; font-size: 70px; }
        .p2 { top: 22%; right: 12%; animation-delay: 3s; font-size: 65px; }
        .p3 { bottom: 15%; left: 12%; animation-delay: 6s; font-size: 80px; }
        .p4 { bottom: 22%; right: 8%; animation-delay: 1.5s; font-size: 75px; }
        .p5 { top: 45%; left: 4%; animation-delay: 8s; font-size: 60px; }
        .p6 { bottom: 45%; right: 3%; animation-delay: 4.5s; font-size: 68px; }
        
        /* Registration Emojis */
        .e1 { top: 5%; right: 40%; animation-delay: 2s; font-size: 50px; opacity: 0.3; }  
        .e2 { bottom: 8%; left: 45%; animation-delay: 5s; font-size: 55px; opacity: 0.3; } 
        .e3 { top: 60%; left: 22%; animation-delay: 9s; font-size: 45px; opacity: 0.3; } 
        .e4 { top: 35%; right: 25%; animation-delay: 1s; font-size: 48px; opacity: 0.3; } 

        @keyframes floatUpDown {
            0% {
                transform: translateY(105vh) rotate(0deg) scale(0.9);
                opacity: 0;
            }
            15% { opacity: 1; }
            85% { opacity: 1; }
            100% {
                transform: translateY(-15vh) rotate(360deg) scale(1.3);
                opacity: 0;
            }
        }

        /* --- REGISTER MAIN CARD (3D GLOW & HOVER EFFECT) --- */
        .register-box {
            width: 430px;
            background: #ffffff; 
            padding: 40px 35px;
            border-radius: 32px;
            border: 2px solid #fce8e6; 
            z-index: 2;
            box-shadow: 0 10px 35px rgba(234, 67, 53, 0.04);
            backdrop-filter: blur(10px);
            transform-style: preserve-3d;
            transition: all 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
            margin: auto; 
        }

        .register-box:hover {
            transform: translateY(-6px) rotateX(4deg) rotateY(5deg); 
            border-color: rgba(234, 67, 53, 0.5); 
            box-shadow: 
                0 0 35px rgba(234, 67, 53, 0.25),   
                0 20px 45px rgba(234, 67, 53, 0.1),    
                0 4px 12px rgba(0, 0, 0, 0.02);
        }

        .register-box h2 {
            font-size: 28px;
            font-weight: 500;
            color: #ea4335; /* Premium Gmail Red Header */
            text-align: center;
            margin-bottom: 25px;
            letter-spacing: -0.5px;
            transform: translateZ(25px);
        }

        .input-box {
            margin-bottom: 18px;
            transform: translateZ(15px);
        }

        .input-box input {
            width: 100%;
            padding: 13px 16px;
            border: 1px solid #dadce0;
            border-radius: 12px;
            font-size: 15px;
            outline: none;
            transition: all 0.2s ease;
            color: #1f1f1f;
        }

        .input-box input:focus {
            border-color: #ea4335;
            box-shadow: 0 0 0 3px rgba(234, 67, 53, 0.1);
        }

        /* Register Submit Button (Premium Gmail Red) */
        button {
            width: 100%;
            padding: 14px;
            background: #ea4335; 
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            transform: translateZ(20px);
        }

        button:hover {
            background: #d93025; 
            box-shadow: 0 4px 18px rgba(234, 67, 53, 0.45);
            transform: translateY(-1px);
        }

        p {
            text-align: center;
            margin-top: 20px;
            font-size: 14px;
            color: #5f6368;
            transform: translateZ(10px);
        }

        a {
            text-decoration: none;
            color: #ea4335;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        a:hover {
            color: #d93025;
            text-decoration: underline;
        }
    </style>

</head>
<body>

<!-- Background Floating Decorators (R-E-G-I-S-T-E-R) -->
<div class="bg-element p1">R</div>
<div class="bg-element p2">E</div>
<div class="bg-element p3">G</div>
<div class="bg-element p4">I</div>
<div class="bg-element p5">S</div>
<div class="bg-element p6">T</div>

<!-- Registration Emojis -->
<div class="bg-element e1">📝</div> 
<div class="bg-element e2">🆔</div> 
<div class="bg-element e3">✉️</div> 
<div class="bg-element e4">🔑</div> 

<!-- Centralized 3D Card Form -->
<div class="register-box">

    <h2>Create Account</h2>

    <form id="registerForm">

        <div class="input-box">
            <input type="text" name="fullName" placeholder="Full Name" required>
        </div>

        <div class="input-box">
            <input type="text" name="username" placeholder="Username" required>
        </div>

        <div class="input-box">
            <input type="email" name="email" placeholder="Email Address" required>
        </div>

        <div class="input-box">
            <input type="password" name="password" placeholder="Password" required>
        </div>

        <button type="submit">Register</button>

    </form>

    <p>Already have an account? <a href="/login">Login</a></p>

</div>

<script>
    // Form submission ko handle karne ke liye JavaScript logic
    document.getElementById('registerForm').addEventListener('submit', async function(e) {
        e.preventDefault(); // Page ko reload hone se rokega

        // Form ka saara data ikattha karega
        const formData = new URLSearchParams(new FormData(this));

        try {
            // Backend par request bhej raha hai
            const response = await fetch('/register', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: formData
            });

            // Agar data successfully save ho gaya, toh home page par redirect karega
            if (response.ok) {
                window.location.href = '/home'; 
            } else {
                const text = await response.text();
                alert("Error: " + text); // Agar koi error aaye toh alert dikhayega
            }
        } catch (error) {
            console.error("Error:", error);
            // Agar backend se redirect automatic nahi ho raha, fir bhi force redirect karne ke liye:
            window.location.href = '/home';
        }
    });
</script>

</body>
</html>