<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome Dashboard</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body { background-color: #eef2f3; display: flex; justify-content: center; align-items: center; height: 100vh; }
        .welcome-card { background: white; padding: 50px; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); text-center: center; max-width: 500px; width: 100%; }
    </style>
</head>
<body>

<div class="welcome-card text-center">
    <div class="mb-4">
        <span style="font-size: 60px;">🎉</span>
    </div>
    <h2 class="text-success mb-2">Successfully Logged In!</h2>
    <p class="text-muted mb-4">Welcome back, <strong>{{user.fullName}}</strong>! You have accessed your dashboard securely.</p>
    
    <div class="d-grid gap-2">
        <a href="/list" class="btn btn-outline-secondary">View Registered Users List</a>
        <a href="/logout" class="btn btn-danger mt-2">Logout</a>
    </div>
</div>

</body>
</html>